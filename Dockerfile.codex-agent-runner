# Codex agent image. One of the per-harness agent-runner images (the claude
# harness has its own, Dockerfile.claude-agent-runner); a Job runs the image of
# the harness resolved for its model. Used for BOTH containers of the ephemeral
# Job that internal/jobs creates:
#
#   initContainer "prepare": runs /bin/sh with the prepare script. It needs
#     sh, curl and git: it downloads the repository tarball from
#     source-controller, checks its digest and makes a local base commit. No
#     credential reaches it.
#   container "agent": runs `agent-runner`, which must be on PATH under that
#     exact name (internal/jobs sets Command: []string{"agent-runner"}). It
#     runs `codex exec ...` (internal/harness) and `git` (to diff the
#     changeset).
#
# So the image must carry the agent-runner binary, git, curl, /bin/sh and the
# codex CLI. codex ships as a self-contained native (musl-static) binary,
# so the runtime base is wolfi-base: busybox sh, ca-certificates and the
# nonroot user, and nothing else. There is no node or npm. We use Wolfi over
# debian-slim because Chainguard rebuilds it against upstream security fixes
# all the time, which keeps the lint-docker grype check on base images clean.
# Debian's official images lag the security archive until the next image
# rebuild. The fetch stage below downloads the pinned version from the GitHub
# release and rejects anything whose sha256 does not match the per-arch pin.
# Only the verified binary reaches the runtime stage.
#
# Built by GoReleaser (`dockers_v2` in .goreleaser.yaml): the agent-runner
# binary is compiled by GoReleaser and arrives in the build context at
# $TARGETPLATFORM/agent-runner. There is no Go toolchain or source here.
#
# readOnlyRootFilesystem: internal/jobs runs both containers with a read-only
# root filesystem, uid 65532, all capabilities dropped. The only writable
# paths are /workspace (emptyDir, and HOME) and /tmp (emptyDir); codex keeps
# its state under $HOME=/workspace.
# latest is the only tag wolfi-base publishes; the digest is the real pin
# (renovate bumps it).
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:28c39be5a5e1e9b85081c10740e8495f6518a865b23bc6a486637c4b21e74b43 AS fetch

# ca-certificates-bundle ships in the base.
# hadolint ignore=DL3018
RUN apk add --no-cache curl

# Pinned codex CLI release. Renovate bumps each tag + sha256 pair together via
# the org preset's release-asset manager (one annotated block per arch; both
# land in the same PR): codex publishes native binaries per GitHub release (tag
# rust-v<version>) but no checksum manifest, so the digests are pinned inline
# for a reproducible, attributable image. The full tag is pinned (not the bare
# version) because Renovate resolves the asset digest by release tag.
# renovate: datasource=github-release-attachments depName=openai/codex versioning=regex:^rust-v(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
ARG CODEX_AMD64_RELEASE=rust-v0.171.0
ARG CODEX_AMD64_SHA256=01baa2e47809f8597be5b2f8abd4e4dfe3fb5bcb6e504c2fbaaad97056c15e8d
# renovate: datasource=github-release-attachments depName=openai/codex versioning=regex:^rust-v(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
ARG CODEX_ARM64_RELEASE=rust-v0.171.0
ARG CODEX_ARM64_SHA256=bcf50b836385e51bd2976ab2bbe92b1b08a1cbe37712eb8dbe378aa78d24871c

# Fetch the static musl binary for the target platform from the GitHub release
# and verify it against the pinned sha256 before it leaves this stage. The
# tarball holds a single file named after the target triple; rename it to
# /codex.
ARG TARGETARCH
# hadolint ignore=DL4006
RUN case "${TARGETARCH}" in \
        amd64) triple=x86_64-unknown-linux-musl; tag="${CODEX_AMD64_RELEASE}"; sha="${CODEX_AMD64_SHA256}" ;; \
        arm64) triple=aarch64-unknown-linux-musl; tag="${CODEX_ARM64_RELEASE}"; sha="${CODEX_ARM64_SHA256}" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && base="https://github.com/openai/codex/releases/download/${tag}" \
    && curl -fsSL -o /tmp/codex.tar.gz "${base}/codex-${triple}.tar.gz" \
    && echo "${sha}  /tmp/codex.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/codex.tar.gz -C /tmp \
    && mv "/tmp/codex-${triple}" /codex \
    && rm -f /tmp/codex.tar.gz \
    && chmod 0755 /codex

FROM cgr.dev/chainguard/wolfi-base:latest@sha256:28c39be5a5e1e9b85081c10740e8495f6518a865b23bc6a486637c4b21e74b43

# curl serves the init container's credential-less artifact fetch (the
# SHA-pinned repo tarball from source-controller); git serves the agent's
# commit/diff flow. ca-certificates-bundle ships in the base.
# hadolint ignore=DL3018
RUN apk add --no-cache curl git

COPY --from=fetch /codex /usr/local/bin/codex

ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/agent-runner /usr/local/bin/agent-runner

# No user setup: wolfi-base already ships the nonroot user, uid 65532. That
# matches internal/jobs' runAsUser and the distroless "nonroot" convention.

# HOME is overridden to /workspace by the Job (the only writable dir); this is
# only the sane default for a bare `docker run`.
ENV HOME=/workspace
WORKDIR /workspace

USER 65532:65532
ENTRYPOINT ["agent-runner"]
