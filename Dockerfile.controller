# Image for every cluster service except the agent runners: the controllers,
# status-server and egress-broker each get their own image from this one
# Dockerfile. GoReleaser builds them (`dockers_v2` in .goreleaser.yaml). It
# compiles the binaries first and hands this file a build context that holds
# ONLY those binaries, laid out as $TARGETPLATFORM/<binary> (for example
# linux/amd64/source-controller). There is no Go toolchain or source here.
# GoReleaser's ldflags have already stamped the version into internal/version,
# and the same buildx run produces the linux/amd64 + linux/arm64 manifest.
#
# They all share the same distroless-static runtime: pure Go, CGO off, and no
# external process is ever run. remediation-controller pushes agent changesets
# through the GitHub API (internal/ghpush), so no git binary is needed.
#
# TARGET (the binary to copy) comes from each image's `build_args` in
# .goreleaser.yaml. To build locally without publishing, run `make snapshot`.
# It needs docker and buildx.
#
# Runs as uid 65532 ("nonroot"), matching internal/jobs' runAsUser, and works
# under readOnlyRootFilesystem.

FROM gcr.io/distroless/static-debian13:nonroot@sha256:8ce6dd87e9823c5b48dcfb2c8604714ccb351ce59607327bcc4957448da279b5

ARG TARGETPLATFORM
ARG TARGET

# The binary lands at a fixed path so ENTRYPOINT need not interpolate TARGET
# (exec-form ENTRYPOINT cannot expand build args). The Deployment supplies the
# subcommand: args: ["serve"].
COPY ${TARGETPLATFORM}/${TARGET} /usr/local/bin/controller

USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/controller"]
