# GitHub Copilot agent image. One of the per-harness agent-runner images (claude
# and codex have their own); a Job runs the image of the harness resolved for
# its model. Used for BOTH containers of the ephemeral Job that internal/jobs
# creates:
#
#   initContainer "prepare" — runs /bin/sh with the clone script (needs sh,
#     git and curl; no credential ever reaches it).
#   container "agent"       — runs `agent-runner` (must be on PATH under that
#     exact name: internal/jobs sets Command: []string{"agent-runner"}), which
#     execs `copilot -p ...` (internal/harness) and `git` (changeset diffing).
#
# So the image must carry: the agent-runner binary, git, /bin/sh, and the
# copilot CLI. Like claude and codex, copilot is a single self-contained file:
# the github/copilot-cli release ships a pre-built standalone executable per
# platform (copilot-linux-<arch>.tar.gz, one `copilot` member, glibc build —
# matching the glibc runtime base) plus a SHA256SUMS.txt manifest. This is the
# same asset upstream's install.sh and the Homebrew cask install. The release
# also carries the npm package tarballs (github-copilot-<version>-<os>-<arch>.tgz),
# but those are the @github/copilot loader package tree whose `copilot` bin is a
# Node script — useless without node, which this image deliberately lacks.
#
# The runtime base is wolfi-base — glibc, busybox sh, ca-certificates and the
# nonroot user, nothing else. Wolfi over debian-slim because Chainguard
# rebuilds it against upstream security fixes continuously, so the lint-docker
# grype gate on base images stays clean (debian's official images lag the
# security archive until the next image rebuild).
#
# The fetch stage below downloads the standalone binary from the release — not
# the npm registry: Renovate's npm datasource has no digest support, so registry
# pins strand their checksums on version bumps — and refuses anything whose
# sha256 does not match the per-arch pin, so no node or npm is needed at build
# time or at runtime.
#
# Built by GoReleaser (`dockers_v2` in .goreleaser.yaml): the agent-runner
# binary is compiled by GoReleaser and arrives in the build context at
# $TARGETPLATFORM/agent-runner — no Go toolchain or source here.
#
# readOnlyRootFilesystem: internal/jobs runs both containers with a read-only
# root filesystem, uid 65532, all capabilities dropped. The only writable
# paths are /workspace (emptyDir, and HOME) and /tmp (emptyDir); copilot keeps
# its state under $COPILOT_HOME, which defaults to $HOME/.copilot, and
# COPILOT_AUTO_UPDATE=false pins it to the baked version.
# latest is the only tag wolfi-base publishes; the digest is the real pin
# (renovate bumps it).
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:19f7a7b40a11c435311e3784bd134c6b6f19677462440da48f96d5c84eefd669 AS fetch

# ca-certificates-bundle ships in the base.
# hadolint ignore=DL3018
RUN apk add --no-cache curl

# Pinned copilot CLI release. Renovate bumps each tag + sha256 pair together via
# the org preset's release-asset manager (one annotated block per arch; both
# land in the same PR): the new checksum is resolved from the release's
# SHA256SUMS.txt manifest, so the digests are pinned inline for a reproducible,
# attributable image. The full tag is pinned (not the bare version) because
# Renovate resolves the asset digest by release tag; the plain `v` prefix is
# valid semver to Renovate, so no versioning override is needed (codex's
# rust-v prefix is why it carries one).
#
# The sha256 is also what SELECTS the asset: Renovate finds which asset of the
# current release carries the pinned digest, then follows the same-named asset
# into the new release. The pin must therefore always be the digest of
# copilot-linux-<arch>.tar.gz — pinning some other asset's digest would silently
# retarget every future bump (how the loader-package tarball got pinned once).
# The unversioned asset name keeps that same-name mapping exact across releases.
# renovate: datasource=github-release-attachments depName=github/copilot-cli
ARG COPILOT_AMD64_RELEASE=v1.0.81
ARG COPILOT_AMD64_SHA256=3082c4a27aa683def52e48397c02606dc7f8267dcef1c93949f3f58de4a5cde3
# renovate: datasource=github-release-attachments depName=github/copilot-cli
ARG COPILOT_ARM64_RELEASE=v1.0.81
ARG COPILOT_ARM64_SHA256=f0e621e6793b14e04c0f651cd46d818a5bf0bf54d74c9566c9424744b41a279c

# Fetch the standalone binary tarball for the target platform from the GitHub
# release and verify it against the pinned sha256 before it leaves this stage.
# The tarball holds a single `copilot` executable; the glibc `linux` (not
# `linuxmusl`) build matches the glibc runtime base.
ARG TARGETARCH
# hadolint ignore=DL4006
RUN case "${TARGETARCH}" in \
        amd64) arch=x64; tag="${COPILOT_AMD64_RELEASE}"; sha="${COPILOT_AMD64_SHA256}" ;; \
        arm64) arch=arm64; tag="${COPILOT_ARM64_RELEASE}"; sha="${COPILOT_ARM64_SHA256}" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && base="https://github.com/github/copilot-cli/releases/download/${tag}" \
    && curl -fsSL -o /tmp/copilot.tar.gz "${base}/copilot-linux-${arch}.tar.gz" \
    && echo "${sha}  /tmp/copilot.tar.gz" | sha256sum -c - \
    && mkdir -p /out \
    && tar -xzf /tmp/copilot.tar.gz -C /out copilot \
    && rm -f /tmp/copilot.tar.gz \
    && chmod 0755 /out/copilot

FROM cgr.dev/chainguard/wolfi-base:latest@sha256:19f7a7b40a11c435311e3784bd134c6b6f19677462440da48f96d5c84eefd669

# curl serves the init container's credential-less artifact fetch (the
# SHA-pinned repo tarball from source-controller); git serves the agent's
# commit/diff flow. libstdc++ (which pulls libgcc) is for the copilot binary:
# its ELF NEEDED set includes libstdc++.so.6 and libgcc_s.so.1, which debian
# carried implicitly via apt's own dependency chain but wolfi-base does not.
# ca-certificates-bundle ships in the base.
# hadolint ignore=DL3018
RUN apk add --no-cache curl git libstdc++

COPY --from=fetch /out/copilot /usr/local/bin/copilot

ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/agent-runner /usr/local/bin/agent-runner

# No user setup: wolfi-base already ships the nonroot user, uid 65532 —
# matching internal/jobs' runAsUser (and the distroless "nonroot" convention).

# The CLI self-updates by default outside CI; an image pins a version and runs
# on a read-only rootfs, so updating must never be attempted. internal/harness
# passes --no-auto-update as well — this is the belt to that pair of braces.
ENV COPILOT_AUTO_UPDATE=false

# HOME is overridden to /workspace by the Job (the only writable dir); this is
# only the sane default for a bare `docker run`. COPILOT_HOME follows HOME.
ENV HOME=/workspace
WORKDIR /workspace

USER 65532:65532
ENTRYPOINT ["agent-runner"]
