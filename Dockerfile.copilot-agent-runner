# GitHub Copilot agent image. One of the per-harness agent-runner images (claude
# and codex have their own); a Job runs the image of the harness resolved for
# its model. Used for BOTH containers of the ephemeral Job that internal/jobs
# creates:
#
#   initContainer "prepare" — runs /bin/sh with the clone script (needs sh,
#     git and curl; no credential ever reaches it).
#   container "agent"       — runs `agent-runner` (must be on PATH under that
#     exact name: internal/jobs sets Command: []string{"agent-runner"}), which
#     execs `copilot -p ...` (internal/harness) and `git` (changeset diffing).
#
# So the image must carry: the agent-runner binary, git, /bin/sh, and the
# copilot CLI. Unlike claude and codex, copilot is not a single self-contained
# file: the CLI is a native (glibc) executable that loads sidecar assets — its
# bundled ripgrep/tgrep binaries, builtin skills, agent definitions — from the
# package directory beside it. The whole package therefore installs to
# /opt/copilot and only the entrypoint is symlinked onto PATH; extracting the
# executable alone yields a CLI that starts and then fails to search.
#
# The CLI is published to npm, not to a GitHub release, but only as a native
# per-platform package (@github/copilot-<os>-<arch>) — the top-level
# @github/copilot package is a loader that selects one at install time. The
# fetch stage below downloads the linux package for the target arch straight
# from the registry and refuses anything whose sha256 does not match the per-arch
# pin, so no node or npm is needed at build time or at runtime.
#
# Built by GoReleaser (`dockers_v2` in .goreleaser.yaml): the agent-runner
# binary is compiled by GoReleaser and arrives in the build context at
# $TARGETPLATFORM/agent-runner — no Go toolchain or source here.
#
# readOnlyRootFilesystem: internal/jobs runs both containers with a read-only
# root filesystem, uid 65532, all capabilities dropped. The only writable
# paths are /workspace (emptyDir, and HOME) and /tmp (emptyDir); copilot keeps
# its state under $COPILOT_HOME, which defaults to $HOME/.copilot, and
# COPILOT_AUTO_UPDATE=false pins it to the baked version.
FROM debian:trixie-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd AS fetch

# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# Pinned copilot CLI version. Renovate should bump this ARG and the two per-arch
# sha256 pins together: the per-platform packages are published in lockstep with
# the @github/copilot loader under the same version, so the npm datasource stays
# the source of truth, and the digests are pinned inline for a reproducible,
# attributable image.
# renovate: datasource=npm depName=@github/copilot
ARG COPILOT_VERSION=1.0.75
ARG COPILOT_SHA256_AMD64=3e954cebd1765bb8b2b42e5f322545f005030fdb93c1c2456ea09adcd5e2f87e
ARG COPILOT_SHA256_ARM64=2c8549fc33864de96e0d9d9f97b4ef5ddf0f156db84f4ffecb37fe8d4099da72

# Fetch the native package for the target platform from the npm registry and
# verify it against the pinned sha256 before it leaves this stage. The tarball
# unpacks to package/, whose `copilot` executable expects its siblings to stay
# beside it; the glibc (not linuxmusl) build matches the debian runtime base.
ARG TARGETARCH
# hadolint ignore=DL4006
RUN case "${TARGETARCH}" in \
        amd64) pkg=copilot-linux-x64; sha="${COPILOT_SHA256_AMD64}" ;; \
        arm64) pkg=copilot-linux-arm64; sha="${COPILOT_SHA256_ARM64}" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && url="https://registry.npmjs.org/@github/${pkg}/-/${pkg}-${COPILOT_VERSION}.tgz" \
    && curl -fsSL -o /tmp/copilot.tgz "${url}" \
    && echo "${sha}  /tmp/copilot.tgz" | sha256sum -c - \
    && mkdir -p /opt/copilot \
    && tar -xzf /tmp/copilot.tgz -C /opt/copilot --strip-components=1 \
    && rm -f /tmp/copilot.tgz \
    && chmod 0755 /opt/copilot/copilot

FROM debian:trixie-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd

# curl serves the init container's credential-less artifact fetch (the
# SHA-pinned repo tarball from source-controller); git serves the agent's
# commit/diff flow.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=fetch /opt/copilot /opt/copilot
RUN ln -s /opt/copilot/copilot /usr/local/bin/copilot

ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/agent-runner /usr/local/bin/agent-runner

# uid 65532 matches internal/jobs' runAsUser (and the distroless "nonroot"
# convention). create it: a bare debian image has no non-root user.
RUN groupadd --gid 65532 nonroot \
    && useradd --uid 65532 --gid 65532 --no-create-home --shell /sbin/nologin nonroot

# The CLI self-updates by default outside CI; an image pins a version and runs
# on a read-only rootfs, so updating must never be attempted. internal/harness
# passes --no-auto-update as well — this is the belt to that pair of braces.
ENV COPILOT_AUTO_UPDATE=false

# HOME is overridden to /workspace by the Job (the only writable dir); this is
# only the sane default for a bare `docker run`. COPILOT_HOME follows HOME.
ENV HOME=/workspace
WORKDIR /workspace

USER 65532:65532
ENTRYPOINT ["agent-runner"]
