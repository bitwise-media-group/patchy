{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "patchy-config Helm chart values",
    "type": "object",
    "additionalProperties": false,
    "definitions": {
        "integration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "spec"],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "spec": {
                    "$ref": "#/definitions/integrationSpec"
                }
            }
        },
        "forge": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "spec"],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "spec": {
                    "$ref": "#/definitions/forgeSpec"
                }
            }
        },
        "integrationSpec": {
            "description": "IntegrationSpec configures one external system. Exactly the provider block\nmatching spec.provider must be set (CEL-enforced) — integrations are\nstrongly typed; the generic provider is the deliberate escape hatch, typed\naround patchy's own HTTP contract rather than a vendor's.",
            "properties": {
                "aws": {
                    "description": "AWS is the aws provider block.",
                    "properties": {
                        "resourceTags": {
                            "description": "ResourceTags enables the tag-inventory enhancer.",
                            "properties": {
                                "configAggregator": {
                                    "description": "ConfigAggregator queries an AWS Config aggregator (SQL over recorded\nconfiguration items).",
                                    "properties": {
                                        "name": {
                                            "description": "Name of the configuration aggregator.",
                                            "minLength": 1,
                                            "type": "string"
                                        },
                                        "region": {
                                            "description": "Region the aggregator lives in.",
                                            "minLength": 1,
                                            "type": "string"
                                        }
                                    },
                                    "required": ["name", "region"],
                                    "type": "object",
                                    "additionalProperties": false
                                },
                                "enabled": {
                                    "description": "Enabled turns the enhancer capability on.",
                                    "type": "boolean"
                                },
                                "repositoryHost": {
                                    "description": "RepositoryHost is the forge host repositories named by tags live on;\nempty means github.com.",
                                    "type": "string"
                                },
                                "resourceExplorer": {
                                    "description": "ResourceExplorer searches an AWS Resource Explorer view.",
                                    "properties": {
                                        "viewARN": {
                                            "description": "ViewARN is the Resource Explorer view, e.g.\narn:aws:resource-explorer-2:eu-west-2:123456789012:view/org-view/<uuid>.\nThe region the view lives in is read from the ARN.",
                                            "pattern": "^arn:[a-z-]+:resource-explorer-2:[a-z0-9-]+:[0-9]{12}:view/.+$",
                                            "type": "string"
                                        }
                                    },
                                    "required": ["viewARN"],
                                    "type": "object",
                                    "additionalProperties": false
                                },
                                "tags": {
                                    "description": "Tags overrides the resource tag names the enhancer reads.",
                                    "properties": {
                                        "name": {
                                            "description": "Name label carries the repository name.",
                                            "type": "string"
                                        },
                                        "org": {
                                            "description": "Org label carries the repository owner/organization.",
                                            "type": "string"
                                        },
                                        "provider": {
                                            "description": "Provider label carries the forge kind (e.g. github).",
                                            "type": "string"
                                        },
                                        "url": {
                                            "description": "URL label carries a full repository URL, overriding the parts.",
                                            "type": "string"
                                        }
                                    },
                                    "type": "object",
                                    "additionalProperties": false
                                }
                            },
                            "required": ["enabled"],
                            "type": "object",
                            "additionalProperties": false
                        }
                    },
                    "type": "object",
                    "additionalProperties": false
                },
                "azure": {
                    "description": "Azure is the azure provider block.",
                    "properties": {
                        "resourceTags": {
                            "description": "ResourceTags enables the tag-inventory enhancer.",
                            "properties": {
                                "enabled": {
                                    "description": "Enabled turns the enhancer capability on.",
                                    "type": "boolean"
                                },
                                "managementGroup": {
                                    "description": "ManagementGroup narrows the query scope to one management group; empty\nmeans every subscription the ambient identity can read (the tenant, in\npractice).",
                                    "type": "string"
                                },
                                "repositoryHost": {
                                    "description": "RepositoryHost is the forge host repositories named by tags live on;\nempty means github.com.",
                                    "type": "string"
                                },
                                "tags": {
                                    "description": "Tags overrides the resource tag names the enhancer reads.",
                                    "properties": {
                                        "name": {
                                            "description": "Name label carries the repository name.",
                                            "type": "string"
                                        },
                                        "org": {
                                            "description": "Org label carries the repository owner/organization.",
                                            "type": "string"
                                        },
                                        "provider": {
                                            "description": "Provider label carries the forge kind (e.g. github).",
                                            "type": "string"
                                        },
                                        "url": {
                                            "description": "URL label carries a full repository URL, overriding the parts.",
                                            "type": "string"
                                        }
                                    },
                                    "type": "object",
                                    "additionalProperties": false
                                }
                            },
                            "required": ["enabled"],
                            "type": "object",
                            "additionalProperties": false
                        }
                    },
                    "type": "object",
                    "additionalProperties": false
                },
                "generic": {
                    "description": "Generic is the generic provider block.",
                    "properties": {
                        "enhance": {
                            "description": "Enhance enables the outbound context enhancer.",
                            "properties": {
                                "enabled": {
                                    "description": "Enabled turns the enhancer capability on.",
                                    "type": "boolean"
                                },
                                "timeout": {
                                    "default": "60s",
                                    "description": "Timeout bounds each call.",
                                    "type": "string"
                                },
                                "url": {
                                    "description": "URL patchy POSTs enhancement requests to.",
                                    "minLength": 1,
                                    "pattern": "^https?://.+$",
                                    "type": "string"
                                }
                            },
                            "required": ["enabled", "url"],
                            "type": "object",
                            "additionalProperties": false
                        },
                        "source": {
                            "description": "Source enables the inbound findings webhook.",
                            "properties": {
                                "enabled": {
                                    "description": "Enabled turns the inbound receiver on for this integration.",
                                    "type": "boolean"
                                },
                                "minSeverity": {
                                    "default": "low",
                                    "description": "MinSeverity drops findings below this severity at ingestion.",
                                    "enum": ["low", "medium", "high", "critical"],
                                    "type": "string"
                                },
                                "resolver": {
                                    "description": "Resolver enables verdict write-back to the external process.",
                                    "properties": {
                                        "enabled": {
                                            "description": "Enabled turns the write-back on.",
                                            "type": "boolean"
                                        },
                                        "timeout": {
                                            "default": "60s",
                                            "description": "Timeout bounds each call.",
                                            "type": "string"
                                        },
                                        "url": {
                                            "description": "URL patchy POSTs verdicts to.",
                                            "minLength": 1,
                                            "pattern": "^https?://.+$",
                                            "type": "string"
                                        }
                                    },
                                    "required": ["enabled", "url"],
                                    "type": "object",
                                    "additionalProperties": false
                                }
                            },
                            "required": ["enabled"],
                            "type": "object",
                            "additionalProperties": false
                        }
                    },
                    "type": "object",
                    "additionalProperties": false
                },
                "github": {
                    "description": "GitHub is the github provider block.",
                    "properties": {
                        "baseURL": {
                            "description": "BaseURL points at a GitHub Enterprise Server host; empty means\ngithub.com.",
                            "type": "string"
                        },
                        "codeScanningAlerts": {
                            "description": "CodeScanningAlerts enables scanner ingestion.",
                            "properties": {
                                "enabled": {
                                    "description": "Enabled turns the code-scanning capability on.",
                                    "type": "boolean"
                                }
                            },
                            "required": ["enabled"],
                            "type": "object",
                            "additionalProperties": false
                        },
                        "issues": {
                            "description": "Issues enables the tracking projection.",
                            "properties": {
                                "approveComment": {
                                    "default": "/approve",
                                    "description": "ApproveComment is the comment command that approves a held remediation.",
                                    "type": "string"
                                },
                                "enabled": {
                                    "description": "Enabled turns the issues capability on.",
                                    "type": "boolean"
                                },
                                "fallbackRepository": {
                                    "description": "FallbackRepository (\"owner/repo\") receives the tracking issues of\nfindings that have no repository of their own — cloud findings whose\nresource carries no ownership labels. Without it those findings are\nvisible only through kubectl and the status page. They still cannot be\nremediated: the issue is a human surface, not a work tree.",
                                    "type": "string"
                                }
                            },
                            "required": ["enabled"],
                            "type": "object",
                            "additionalProperties": false
                        },
                        "redelivery": {
                            "description": "Redelivery enables the failed-delivery sweep.",
                            "properties": {
                                "enabled": {
                                    "description": "Enabled turns the sweep on. Requires App credentials — the delivery\nlog is App-scoped, so a PAT integration cannot sweep.",
                                    "type": "boolean"
                                },
                                "lookback": {
                                    "default": "24h",
                                    "description": "Lookback bounds how far back each sweep scans the delivery log.\nGitHub retains deliveries for 30 days.",
                                    "type": "string"
                                }
                            },
                            "required": ["enabled"],
                            "type": "object",
                            "additionalProperties": false
                        }
                    },
                    "type": "object",
                    "additionalProperties": false
                },
                "googleCloud": {
                    "description": "GoogleCloud is the google-cloud provider block.",
                    "properties": {
                        "cloudAssetInventory": {
                            "description": "CloudAssetInventory enables the ownership-label enhancer.",
                            "properties": {
                                "enabled": {
                                    "description": "Enabled turns the enhancer capability on.",
                                    "type": "boolean"
                                },
                                "labels": {
                                    "description": "Labels overrides the resource label names the enhancer reads.",
                                    "properties": {
                                        "name": {
                                            "description": "Name label carries the repository name.",
                                            "type": "string"
                                        },
                                        "org": {
                                            "description": "Org label carries the repository owner/organization.",
                                            "type": "string"
                                        },
                                        "provider": {
                                            "description": "Provider label carries the forge kind (e.g. github).",
                                            "type": "string"
                                        },
                                        "url": {
                                            "description": "URL label carries a full repository URL, overriding the parts.",
                                            "type": "string"
                                        }
                                    },
                                    "type": "object",
                                    "additionalProperties": false
                                },
                                "repositoryHost": {
                                    "description": "RepositoryHost is the forge host repositories named by labels live on;\nempty means github.com.",
                                    "type": "string"
                                },
                                "scope": {
                                    "description": "Scope bounds the asset search: an organization, folder, or project.",
                                    "pattern": "^(organizations|folders|projects)/.+$",
                                    "type": "string"
                                }
                            },
                            "required": ["enabled", "scope"],
                            "type": "object",
                            "additionalProperties": false
                        },
                        "securityCommandCenter": {
                            "description": "SecurityCommandCenter enables SCC finding ingestion.",
                            "properties": {
                                "audience": {
                                    "description": "Audience the push subscription's OIDC token must carry, as configured\non the subscription's oidcToken.audience.",
                                    "minLength": 1,
                                    "type": "string"
                                },
                                "enabled": {
                                    "description": "Enabled turns the SCC ingestion capability on.",
                                    "type": "boolean"
                                },
                                "minSeverity": {
                                    "default": "low",
                                    "description": "MinSeverity drops notifications below this severity before they become\nfindings. The notification filter should do most of this work; this is\nthe backstop.",
                                    "enum": ["low", "medium", "high", "critical"],
                                    "type": "string"
                                },
                                "mute": {
                                    "description": "Mute configures the ignore-verdict write-back (reserved).",
                                    "properties": {
                                        "enabled": {
                                            "description": "Enabled turns the mute-on-ignore write-back on.",
                                            "type": "boolean"
                                        }
                                    },
                                    "required": ["enabled"],
                                    "type": "object",
                                    "additionalProperties": false
                                },
                                "organization": {
                                    "description": "Organization is the numeric Google Cloud organization id, used to\ncompose Console links for findings that carry no externalUri.",
                                    "type": "string"
                                },
                                "serviceAccount": {
                                    "description": "ServiceAccount is the email address the push token must be issued for;\na token from any other identity is rejected.",
                                    "minLength": 1,
                                    "type": "string"
                                }
                            },
                            "required": ["audience", "enabled", "serviceAccount"],
                            "type": "object",
                            "additionalProperties": false
                        }
                    },
                    "type": "object",
                    "additionalProperties": false
                },
                "interval": {
                    "default": "10m",
                    "description": "Interval between credential revalidations.",
                    "type": "string"
                },
                "provider": {
                    "description": "Provider is the external system type.",
                    "enum": ["github", "google-cloud", "wiz", "aws", "azure", "generic"],
                    "type": "string"
                },
                "replay": {
                    "description": "Replay requests one full redelivery of every webhook delivery in the\nlookback window, including deliveries that already succeeded (the\nreceiver dedups; ingestion is idempotent). Freshness against\nstatus.redelivery.replayedAt decides whether the request is still\nactionable — the controller never clears spec.",
                    "properties": {
                        "at": {
                            "description": "At is when the request was received.",
                            "format": "date-time",
                            "type": "string"
                        },
                        "by": {
                            "description": "By is the requesting login.",
                            "type": "string"
                        }
                    },
                    "required": ["at", "by"],
                    "type": "object",
                    "additionalProperties": false
                },
                "reset": {
                    "description": "Reset requests the demo reset (stamped by the status page): the\ncontroller permanently deletes every finding's tracking issue,\nreopens the dismissed findings' code-scanning alerts, deletes every\npipeline resource, and drops the receiver's delivery dedup window so\nredeliveries of already-handled GUIDs are ingested again. Issue\ndeletion requires admin-level repository permission on the\ncredential. Freshness against status.resetAt decides whether the\nrequest is still actionable — the controller never clears spec.",
                    "properties": {
                        "at": {
                            "description": "At is when the request was received.",
                            "format": "date-time",
                            "type": "string"
                        },
                        "by": {
                            "description": "By is the requesting login.",
                            "type": "string"
                        }
                    },
                    "required": ["at", "by"],
                    "type": "object",
                    "additionalProperties": false
                },
                "secretRef": {
                    "description": "SecretRef names the credential Secret. For github: either key \"token\"\n(PAT, dev) or keys \"appID\" + \"privateKey\" (GitHub App), plus\n\"webhookSecret\" for receiver HMAC validation. For wiz: key\n\"webhookToken\" (the shared bearer token deliveries carry), plus keys\n\"clientId\" + \"clientSecret\" when spec.wiz.api enables write-back. For\ngeneric: key \"webhookSecret\", the shared HMAC secret signing both\ninbound deliveries and patchy's outbound resolver/enhancer calls.\nRequired for github, wiz, and generic, optional otherwise — a\ngoogle-cloud integration holds no credential, since Pub/Sub\nauthenticates itself with a signed OIDC token. It stays permitted for\nevery provider so a future capability that does need one (SCC\nmute-on-ignore) needs no schema change.",
                    "properties": {
                        "name": {
                            "description": "Name of the Secret.",
                            "minLength": 1,
                            "type": "string"
                        }
                    },
                    "required": ["name"],
                    "type": "object",
                    "additionalProperties": false
                },
                "suspend": {
                    "description": "Suspend pauses reconciliation of this integration.",
                    "type": "boolean"
                },
                "wiz": {
                    "description": "Wiz is the wiz provider block.",
                    "properties": {
                        "api": {
                            "description": "API enables write-back through the Wiz GraphQL API.",
                            "properties": {
                                "endpoint": {
                                    "description": "Endpoint is the tenant GraphQL endpoint, e.g.\nhttps://api.eu1.app.wiz.io/graphql.",
                                    "minLength": 1,
                                    "type": "string"
                                },
                                "tokenURL": {
                                    "description": "TokenURL is the OAuth2 client-credentials token endpoint; empty means\nhttps://auth.app.wiz.io/oauth/token.",
                                    "type": "string"
                                }
                            },
                            "required": ["endpoint"],
                            "type": "object",
                            "additionalProperties": false
                        },
                        "defend": {
                            "description": "Defend enables Wiz Defend threat-detection ingestion.",
                            "properties": {
                                "enabled": {
                                    "description": "Enabled turns the Wiz Defend ingestion capability on.",
                                    "type": "boolean"
                                },
                                "minSeverity": {
                                    "default": "low",
                                    "description": "MinSeverity drops detections below this severity before they become\nfindings.",
                                    "enum": ["low", "medium", "high", "critical"],
                                    "type": "string"
                                }
                            },
                            "required": ["enabled"],
                            "type": "object",
                            "additionalProperties": false
                        },
                        "issues": {
                            "description": "Issues enables Wiz Issues ingestion.",
                            "properties": {
                                "enabled": {
                                    "description": "Enabled turns the Wiz Issues ingestion capability on.",
                                    "type": "boolean"
                                },
                                "minSeverity": {
                                    "default": "low",
                                    "description": "MinSeverity drops issues below this severity before they become\nfindings. Wiz INFORMATIONAL ranks below low, so the default floor\ndrops it.",
                                    "enum": ["low", "medium", "high", "critical"],
                                    "type": "string"
                                }
                            },
                            "required": ["enabled"],
                            "type": "object",
                            "additionalProperties": false
                        }
                    },
                    "type": "object",
                    "additionalProperties": false
                }
            },
            "required": ["provider"],
            "type": "object",
            "additionalProperties": false
        },
        "forgeSpec": {
            "description": "ForgeSpec configures repository credentials for one forge, scoped by\noptional org and repository filters. Matching (in internal/forge): the\nrepository URL's host must equal the forge host, then the org allowlist,\nthen the repository regexes; when several Forges match, the more\nconstrained spec wins (orgs set beats unset, then repositories set beats\nunset) and a remaining tie is a configuration error surfaced on the\nFinding.",
            "properties": {
                "baseURL": {
                    "description": "BaseURL is the forge host; empty means the provider's public host\n(github.com).",
                    "type": "string"
                },
                "interval": {
                    "default": "10m",
                    "description": "Interval between credential revalidations.",
                    "type": "string"
                },
                "orgs": {
                    "description": "Orgs restricts this forge to the listed organizations; empty means all.",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "provider": {
                    "description": "Provider is the forge family.",
                    "enum": ["github"],
                    "type": "string"
                },
                "repositories": {
                    "description": "Repositories restricts this forge to repositories whose \"owner/name\"\nmatches any of the listed RE2 regular expressions; empty means all.",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "secretRef": {
                    "description": "SecretRef names the credential Secret: key \"token\" (PAT, dev) or keys\n\"appID\" + \"privateKey\" (GitHub App).",
                    "properties": {
                        "name": {
                            "description": "Name of the Secret.",
                            "minLength": 1,
                            "type": "string"
                        }
                    },
                    "required": ["name"],
                    "type": "object",
                    "additionalProperties": false
                },
                "suspend": {
                    "description": "Suspend pauses reconciliation of this forge.",
                    "type": "boolean"
                }
            },
            "required": ["provider", "secretRef"],
            "type": "object",
            "additionalProperties": false
        }
    },
    "properties": {
        "global": {
            "type": "object"
        },
        "nameOverride": {
            "type": "string"
        },
        "fullnameOverride": {
            "type": "string"
        },
        "commonLabels": {
            "type": "object"
        },
        "commonAnnotations": {
            "type": "object"
        },
        "integrations": {
            "type": "array",
            "description": "Integration custom resources rendered into the release namespace",
            "items": {
                "$ref": "#/definitions/integration"
            }
        },
        "forges": {
            "type": "array",
            "description": "Forge custom resources rendered into the release namespace",
            "items": {
                "$ref": "#/definitions/forge"
            }
        }
    }
}
