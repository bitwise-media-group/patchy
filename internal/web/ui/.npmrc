# npm 12 defaults allow-remote to "none" and, as of 12.2.0, misapplies it to
# registry tarballs: `npm install --package-lock-only` cracks open every
# package with bundleDependencies (tailwind's @tailwindcss/oxide-wasm32-wasi)
# by its resolved URL, which pacote classifies as a remote spec, and the
# registry-host exemption reify applies is missing from buildIdealTree. That
# fails Renovate's lockfile regeneration with EALLOWREMOTE. "root" is not
# enough (the package is transitive), so restore npm 11's default; the
# lockfile still pins every tarball by integrity. Drop this once npm exempts
# registry tarballs in buildIdealTree too.
allow-remote=all
