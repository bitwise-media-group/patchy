{
  "name": "patchy-status-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "description": "Patchy finding status page (embedded into the status-server binary).",
  "scripts": {
    "dev": "bun node_modules/vite/bin/vite.js",
